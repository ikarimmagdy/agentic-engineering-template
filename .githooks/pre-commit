#!/bin/sh
# Refuse a commit made with the wrong git identity.
# The expected author email lives in .claude/git-identity (one line). A line starting
# with "@" (e.g. @example.com) accepts any address at that domain, for team repos.
# Enable once per clone:  git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel)
file="$root/.claude/git-identity"
[ -f "$file" ] || exit 0

expected=$(head -n 1 "$file" | tr -d '[:space:]')
actual=$(git config user.email)

case "$expected" in
  @*) case "$actual" in *"$expected") exit 0 ;; esac ;;
  *) [ "$actual" = "$expected" ] && exit 0 ;;
esac

if [ -n "$expected" ]; then
  echo "pre-commit: git user.email is '$actual', this project expects '$expected'." >&2
  case "$expected" in
    @*) echo "Fix with: git config user.email <you>$expected" >&2 ;;
    *) echo "Fix with: git config user.email $expected" >&2 ;;
  esac
  exit 1
fi
